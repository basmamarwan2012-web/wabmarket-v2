rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasValidRole() {
      return request.auth != null
        && request.auth.token.role in [
          'administrator',
          'manager',
          'operator',
          'viewer'
        ];
    }

    function isOwner(userId) {
      return hasValidRole() && request.auth.uid == userId;
    }

    function canModifyFiles() {
      return request.auth.token.role in [
        'administrator',
        'manager'
      ];
    }

    function isAllowedUpload() {
      return request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches(
          '(application/pdf|image/jpeg|image/png|image/webp|image/svg\\+xml)'
        );
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && canModifyFiles()
        && isAllowedUpload();
      allow delete: if isOwner(userId) && canModifyFiles();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
